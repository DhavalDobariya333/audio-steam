<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0a0a12">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Audio Monitor"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#a78bfa"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvClientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Client: —"
        android:textSize="12sp"
        android:textColor="#555570"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Status Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="#0d0d16"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/vStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#f87171"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="○ Stopped"
            android:textColor="#f87171"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Server URL Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server URL"
        android:textColor="#8888a0"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1a1a2e"
        android:textColor="#e4e4ec"
        android:padding="12dp"
        android:hint="https://your-tunnel.trycloudflare.com"
        android:textColorHint="#555570"
        android:inputType="textUri"
        android:textSize="13sp"
        android:singleLine="true"
        android:layout_marginBottom="16dp"/>

    <!-- Control Buttons -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="▶  START MONITORING"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#7c5cfc"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="■  STOP MONITORING"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#f87171"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnStandby"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📡 ENABLE REMOTE LISTENING"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#1a1a2e"
        android:textColor="#a78bfa"
        android:layout_marginBottom="16dp"/>

    <!-- Stats Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <!-- Connection -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#0d0d16"
            android:padding="10dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTION"
                android:textColor="#555570"
                android:textSize="9sp"/>
            <TextView
                android:id="@+id/tvConnection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#8888a0"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Pending -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#0d0d16"
            android:padding="10dp"
            android:layout_marginStart="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textColor="#555570"
                android:textSize="9sp"/>
            <TextView
                android:id="@+id/tvPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#e4e4ec"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <!-- Retries -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#0d0d16"
            android:padding="10dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RETRIES"
                android:textColor="#555570"
                android:textSize="9sp"/>
            <TextView
                android:id="@+id/tvRetries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#e4e4ec"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Duration -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#0d0d16"
            android:padding="10dp"
            android:layout_marginStart="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DURATION"
                android:textColor="#555570"
                android:textSize="9sp"/>
            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#e4e4ec"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Storage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0d0d16"
        android:padding="10dp"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STORAGE"
            android:textColor="#555570"
            android:textSize="9sp"/>
        <TextView
            android:id="@+id/tvStorage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#8888a0"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Log Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACTIVITY LOG"
        android:textColor="#555570"
        android:textSize="10sp"
        android:layout_marginBottom="4dp"/>

    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0d0d16"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8888a0"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"/>
    </ScrollView>

</LinearLayout>
